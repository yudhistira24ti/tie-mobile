<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">


    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#6750A4"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:title="Pertemuan 10"
        app:titleTextColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Konten -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <!-- Judul -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Background Drawable"
                android:textColor="#222222"
                android:textSize="22sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Contoh EditText dengan background dan border."
                android:textColor="#666666"
                android:textSize="14sp" />


            <!-- Nama -->
            <EditText
                android:id="@+id/etNama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/edit_text_background"
                android:hint="Masukkan nama"
                android:inputType="textPersonName"
                android:textColor="#222222"
                android:textColorHint="#888888" />


            <!-- Email -->
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/edit_text_background"
                android:hint="Masukkan email"
                android:inputType="textEmailAddress"
                android:textColor="#222222"
                android:textColorHint="#888888" />


            <!-- Password -->
            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/edit_text_background"
                android:hint="Masukkan NomorHP"
                android:inputType="textPhonetic"
                android:textColor="#222222"
                android:textColorHint="#888888" />


            <!-- Login -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Login"
                app:cornerRadius="10dp" />


            <!-- Judul Chip -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Pilih Filter"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold" />


            <!-- ChipGroup -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true"
                app:selectionRequired="true">


                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTerbaru"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Terbaru" />


                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPenting"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Penting" />


                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBelumDibaca"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Belum Dibaca" />


            </com.google.android.material.chip.ChipGroup>


            <!-- Judul Grid -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="GridLayout Menu"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Enam tombol dalam tiga kolom."
                android:textColor="#666666"
                android:textSize="14sp" />


            <!-- GridLayout -->
            <androidx.gridlayout.widget.GridLayout
                android:id="@+id/gridMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="4dp"
                app:columnCount="3"
                app:useDefaultMargins="true">


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menu 1"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menu 2"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menu 3"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menu 4"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menu 5"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menu 6"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />


            </androidx.gridlayout.widget.GridLayout>


        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>